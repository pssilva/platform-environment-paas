# Selecione a tag suportada da imagem OneAgent na documentação da Dynatrace.
ONEAGENT_IMAGE=dynatrace/oneagent:<tag>

# Obtenha esses dados no Dynatrace Hub > OneAgent > Set up > Linux.
# Trate URL e token como credenciais; não versionar o arquivo .env.
ONEAGENT_INSTALLER_SCRIPT_URL=
ONEAGENT_INSTALLER_DOWNLOAD_TOKEN=
